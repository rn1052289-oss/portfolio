# Xserver / Apache configuration for the public document root.

Options -Indexes

# Serve the portfolio's own not-found page. It uses root-relative asset paths
# so it renders correctly at any missing URL depth.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Serve one canonical HTTPS origin. Using a fixed host also prevents Host
	# header values from being reflected into the redirect destination.
	RewriteCond %{HTTPS} !=on [OR]
	RewriteCond %{HTTP_HOST} !^rnportfolio\.xsrv\.jp$ [NC]
	RewriteRule ^ https://rnportfolio.xsrv.jp%{REQUEST_URI} [R=301,L,NE]

	# Serve the portfolio's top-level pages without ".html" (e.g. /works).
	# Only files directly under this root are affected; the demo sites in
	# subdirectories keep their own URLs.
	#
	# 1) Old ".html" URLs that a browser asked for directly move permanently to
	#    the extensionless form. THE_REQUEST only holds the original request
	#    line, so the internal rewrite in step 2 cannot loop back here.
	#    404.html stays reachable as-is because ErrorDocument serves it.
	RewriteCond %{THE_REQUEST} \s/index\.html[?\s]
	RewriteRule ^index\.html$ / [R=301,L]

	RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.html[?\s]
	RewriteCond %1 !^404$
	RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]

	# 2) Answer "/works" with works.html when that file exists. "/index" and
	#    "/404" are left out so the same page has no second address.
	RewriteCond $1 !^(?:index|404)$
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME}.html -f
	RewriteRule ^([a-z0-9-]+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Header always set Cross-Origin-Opener-Policy "same-origin"

	# Apply the strict CSP only to this portfolio and its bundled demos. Other
	# applications under the same public root (for example /syumatucoffee/ and
	# /yuakari/) use their own external services and must not inherit this policy.
	# Pages match both with and without ".html", because the portfolio's own
	# pages are served at extensionless URLs (see the rewrite rules above).
	<IfModule mod_setenvif.c>
		SetEnvIf Request_URI "^/(?:$|(?:index|404|works(?:-[a-z0-9-]+)?|freelance|pricing|about|engineer|contact|privacy)(?:\.html)?$|contact-submit\.php|juku_demo(?:/|$)|salon_demo(?:/|$)|kazecoffee(?:/|$)|odawara-lacquerware-fixed(?:/|$))" riku_portfolio_csp=1
		SetEnvIf Request_URI "^/(?:syumatucoffee|yuakari)(?:/|$)" riku_wp_demo_noindex=1
		Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://docs.google.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; upgrade-insecure-requests" env=riku_portfolio_csp
		Header always set X-Robots-Tag "noindex, nofollow" env=riku_wp_demo_noindex
	</IfModule>

	# Browsers ignore HSTS received over plain HTTP. includeSubDomains is
	# intentionally omitted because this project does not control their use.
	Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Prevent common local or backup files from being downloaded if they are
# accidentally uploaded with the site.
<FilesMatch "^(\.DS_Store|\.env(?:\..*)?|.*\.(?:bak|backup|orig|sql|log))$">
	Require all denied
</FilesMatch>

# Revalidate HTML so published updates are not kept as stale browser pages.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
